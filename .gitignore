# ---------------------------------------------------------------
# Mamá en movimiento — ficheros que NO deben estar en el repositorio
# ---------------------------------------------------------------

# Dependencias (se reinstalan con `npm install`)
node_modules/

# Expo / Metro (cachés y ficheros generados)
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
expo-env.d.ts.tmp
*.tmp
.metro-health-check*

# Proyectos nativos generados (`npx expo prebuild`); se regeneran
/ios
/android

# Builds y firmas de las tiendas (¡secretos!)
*.apk
*.aab
*.ipa
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
google-services.json
GoogleService-Info.plist
credentials.json
.eas/

# Variables de entorno: URLs, client IDs de Google, claves...
.env
.env.*
!.env.example

# Logs y depuración
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Sistema y editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# TypeScript
*.tsbuildinfo

# Backend: base de datos local y compilados de Next.js
backend/data/
backend/.next/
backend/next-env.d.ts

# Material de trabajo pesado que no forma parte de la app
*.mov
*.mp4
