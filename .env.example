# App móvil. Copia como .env.local y ajusta.
# Dirección del backend: la IP wifi de tu Mac (para probar en el móvil),
# o "demo" para usar datos de ejemplo sin servidor.
EXPO_PUBLIC_API_URL=http://192.168.1.XXX:3000

# Google (Google Cloud → Credenciales → ID de cliente OAuth)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
