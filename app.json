{
  "expo": {
    "name": "Mamá en movimiento",
    "slug": "mama-en-movimiento",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mamaenmovimiento",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "es.clinicafatimaveiga.mamaenmovimiento"
    },
    "android": {
      "package": "es.clinicafatimaveiga.mamaenmovimiento",
      "adaptiveIcon": {
        "backgroundColor": "#FBF4F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceder a tus fotos para que la clínica pueda subir la foto de las profesionales y las imágenes de las clases.",
          "cameraPermission": "La app necesita la cámara para hacer la foto de las profesionales o de las clases."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF4F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
