# Copia este fichero como .env y rellena los valores.

# Base de datos. En desarrollo: la de `npm run db` (Postgres embebido).
# En producción: la de Neon (host "-pooler", región Frankfurt).
DATABASE_URL=postgres://postgres:postgres@localhost:55432/app

# Hora del centro (las horas del horario base son hora de Santander).
TZ=Europe/Madrid

# Emails (opcional). Sin RESEND_API_KEY los emails se escriben en la consola.
RESEND_API_KEY=
EMAIL_FROM="Mamá en movimiento <avisos@tu-dominio.es>"

# Google: client IDs separados por comas (web, android, ios).
GOOGLE_CLIENT_IDS=

# Clave para la tarea programada de recordatorios (/api/cron/recordatorios).
CRON_SECRET=cambia-esto

# URL pública del backend (enlaces de los emails).
URL_PUBLICA=http://localhost:3000

# Webs que pueden usar la API desde el navegador (producción), separadas por comas.
CORS_ORIGENES=
